
api: {}

log:
  filePath: '/dev/stdout'
  format: common
  level: INFO

metrics:
  prometheus:
    manualRouting: true
    buckets:
      - 0.1
      - 0.3
      - 1.2
      - 5.0

entryPoints:
  web:
    address: ':80'
  websecure:
    address: ':443'

providers:
  docker:
    endpoint: 'unix:///var/run/docker.sock'
    exposedByDefault: false

certificatesResolvers:
  letsencrypt:
    acme:
      email: '{{ traefik_letsencrypt_email_address }}'
      storage: '/etc/traefik/certs/acme.json'
      dnsChallenge:
        provider: cloudflare
