{{ ansible_managed | comment }}

api: {}

log:
  filePath: '/dev/stdout'
  format: common
  level: {{ "DEBUG" if core_apps_traefik_test_environment else "INFO" }}

# metrics:
#   prometheus:
#     manualRouting: true
#     buckets:
#       - 0.1
#       - 0.3
#       - 1.2
#       - 5.0

entryPoints:
  web:
    address: ':80'
{% if not core_apps_traefik_test_environment %}
  websecure:
    address: ':443'
    asDefault: true
    http:
      tls:
        certResolver: letsencrypt
{% endif %}

providers:
  docker:
    endpoint: 'unix:///var/run/docker.sock'
    exposedByDefault: false
  file:
    directory: '/etc/traefik/config.d'

{% if not core_apps_traefik_test_environment %}
certificatesResolvers:
  letsencrypt:
    acme:
      email: '{{ vault.traefik_letsencrypt_email_address }}'
      storage: '/etc/traefik/certs/acme.json'
      dnsChallenge:
        provider: cloudflare
{% endif %}
