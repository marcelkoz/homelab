{{ ansible_managed | comment }}

global:
  scrape_interval: {{ core_apps_prometheus_scrape.interval }}
  scrape_timeout: {{ core_apps_prometheus_scrape.timeout }}

scrape_configs:
  - job_name: netdata
    metrics_path: /api/v1/allmetrics
    honor_labels: true
    params:
      # use hostnames
      format: [prometheus_all_hosts]
      server: ['prometheus1']

    # TODO: do this a better way
    static_configs:
      - targets: {{ core_apps_prometheus_netdata_applicable_servers | map('regex_replace', '$', ':' ~ core_apps_prometheus_netdata_port) | to_yaml }}
