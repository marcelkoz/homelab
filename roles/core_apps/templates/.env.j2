{{ ansible_managed | comment }}
## SECRET
SECRET_CLOUDFLARE_API_TOKEN={{ core_apps_template_secret_cloudflare_api_token }}


## METADATA
METADATA_DOMAIN={{ core_apps_template_metadata_domain }}
METADATA_SSO_BASE_URL={{ core_apps_template_metadata_sso_base_url }}
METADATA_URL_PORT={{ core_apps_template_metadata_url_port }}
METADATA_URL_SCHEME={{ core_apps_template_metadata_url_scheme }}


## SUBDOMAIN
SUBDOMAIN_AUTHENTIK={{ core_apps_template_subdomain_authentik }}
SUBDOMAIN_DAISY={{ core_apps_template_subdomain_daisy }}
SUBDOMAIN_GLANCE={{ core_apps_template_subdomain_glance }}
SUBDOMAIN_GRAFANA={{ core_apps_template_subdomain_grafana }}
SUBDOMAIN_PIHOLE={{ core_apps_template_subdomain_pihole }}
SUBDOMAIN_PROMETHEUS={{ core_apps_template_subdomain_prometheus }}
SUBDOMAIN_TRAEFIK={{ core_apps_template_subdomain_traefik }}


## IMAGE SOURCE
IMAGE_SOURCE_AUTHENTIK=ghcr.io/goauthentik/server
IMAGE_SOURCE_DAISY_APP=daisy-app
IMAGE_SOURCE_DAISY_WEB=daisy-web
IMAGE_SOURCE_GLANCE=glanceapp/glance
IMAGE_SOURCE_GRAFANA=grafana/grafana
IMAGE_SOURCE_PIHOLE=pihole/pihole
IMAGE_SOURCE_POSTGRES=postgres
IMAGE_SOURCE_PROMETHEUS=prom/prometheus
IMAGE_SOURCE_TRAEFIK=traefik


## IMAGE TAG
IMAGE_TAG_AUTHENTIK=2026.5.2
IMAGE_TAG_DAISY=latest
IMAGE_TAG_GLANCE=latest
IMAGE_TAG_GRAFANA=13.2.5
IMAGE_TAG_PIHOLE=2026.10.0
IMAGE_TAG_POSTGRES=16-alpine
IMAGE_TAG_PROMETHEUS=v3.16.0
IMAGE_TAG_TRAEFIK=v3.7.16


## AUTHENTIK
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_PASS={{ core_apps_template_authentik_db_pass }}
AUTHENTIK_DB_USER=weeman
AUTHENTIK_ENCRYPTION_KEY={{ core_apps_template_authentik_encryption_key }}


## PROMETHEUS
PROMETHEUS_RETENTION_STORAGE=4GB
PROMETHEUS_RETENTION_TIME=15d


## GRAFANA
GRAFANA_OIDC_CLIENT_ID={{ core_apps_template_grafana_oidc_client_id }}
GRAFANA_OIDC_CLIENT_SECRET={{ core_apps_template_grafana_oidc_client_secret }}
GRAFANA_OIDC_SLUG=grafana
