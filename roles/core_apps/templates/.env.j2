{{ ansible_managed | comment }}
## SECRET
SECRET_CLOUDFLARE_API_TOKEN={{ core_apps_template_secret_cloudflare_api_token }}


## METADATA
METADATA_DOMAIN={{ core_apps_template_metadata_domain }}
METADATA_SSO_BASE_URL={{ core_apps_template_metadata_sso_base_url }}


## IMAGE SOURCE
IMAGE_SOURCE_ACTUAL_BUDGET=actualbudget/actual-server
IMAGE_SOURCE_AUTHENTIK=ghcr.io/goauthentik/server
IMAGE_SOURCE_DAISY_APP=daisy-app
IMAGE_SOURCE_DAISY_WEB=daisy-web
IMAGE_SOURCE_HOMARR=ghcr.io/homarr-labs/homarr
IMAGE_SOURCE_PIHOLE=pihole/pihole
IMAGE_SOURCE_POSTGRES=postgres
IMAGE_SOURCE_TRAEFIK=traefik


## IMAGE TAG
IMAGE_TAG_ACTUAL_BUDGET=latest
IMAGE_TAG_AUTHENTIK=2026.5.2
IMAGE_TAG_DAISY=latest
IMAGE_TAG_HOMARR=latest
IMAGE_TAG_PIHOLE=2026.10.0
IMAGE_TAG_POSTGRES=16-alpine
IMAGE_TAG_TRAEFIK=v3.7.16


## HOMARR
HOMARR_ENCRYPTION_KEY={{ core_apps_template_homarr_encryption_key }}
HOMARR_OIDC_CLIENT_ID={{ core_apps_template_homarr_oidc_client_id }}
HOMARR_OIDC_CLIENT_SECRET={{ core_apps_template_homarr_oidc_client_secret }}
HOMARR_OIDC_SLUG=homarr


## AUTHENTIK
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_PASS={{ core_apps_template_authentik_db_pass }}
AUTHENTIK_DB_USER=weeman
AUTHENTIK_ENCRYPTION_KEY={{ core_apps_template_authentik_encryption_key }}
