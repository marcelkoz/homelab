{{ ansible_managed | comment }}

set -e

mkdir -p {{ core_apps_backups_path }}
CURRENT_TIMESTAMP="$(printf '%(%Y-%m-%d)T' -1)"



### actual budget
echo COPY SCRIPT INFO: Backup actual budget data

mkdir -p {{ core_apps_backups_path }}/actual-budget-data
cd {{ core_apps_backups_path }}/actual-budget-data

docker compose -f {{core_apps_service_path.docker }}/docker-compose.yml down actual-budget
cp -rf {{ core_apps_service_path.actual_budget }}/data .
docker compose -f {{core_apps_service_path.docker }}/docker-compose.yml up -d actual-budget

cd ..
tar -czvf "actual-budget-data_$CURRENT_TIMESTAMP.tar.gz" actual-budget-data



