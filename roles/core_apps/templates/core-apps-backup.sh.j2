{{ ansible_managed | comment }}

BACKUPS_PATH='{{ core_apps_backups_path }}'
COMPOSE_FILE='{{ core_apps_service_path.docker }}/docker-compose.yml'
CURRENT_TIMESTAMP="$(printf '%(%Y-%m-%d_%H%M%S)T\n' -1)"

cleanup_script() {
    echo 'SCRIPT ERROR: Script failed, running cleanup'

    docker compose -f "$COMPOSE_FILE" up -d
}

trap 'cleanup_script' ERR

mkdir -p "$BACKUPS_PATH"

# Args:
# 1: Service name
backup_filename() {
    local SERVICE=$1
    echo "$SERVICE-data_$CURRENT_TIMESTAMP.tar.gz"
}

# Args:
# 1: Service name
# 2-N: Source data directory or files (space-separated)
backup_service() {
    local SERVICE=$1
    local SOURCES=("$@")
    local TEMP_DIR="$BACKUPS_PATH/$SERVICE-data"

    echo 'SCRIPT INFO: Backup $SERVICE data'
    mkdir -p "$TEMP_DIR"

    docker compose -f "$COMPOSE_FILE" down "$SERVICE"

    for service in "${SOURCES[@]:1}"; do
        cp -rf "$service" "$TEMP_DIR"
    done

    docker compose -f "$COMPOSE_FILE" up -d "$SERVICE"

    # -C changes dir to avoid nested dirs in the archive
    tar -czvf "$BACKUPS_PATH/$(backup_filename $SERVICE)" -C "$BACKUPS_PATH" "$SERVICE-data"
    rm -r "$TEMP_DIR"
}

backup_service 'actual-budget' '{{ core_apps_service_path.actual_budget }}/data'

backup_service 'pihole' \
    '{{ core_apps_service_path.pihole }}/etc-pihole/pihole.toml' \
    '{{ core_apps_service_path.pihole }}/etc-pihole/gravity.db' \
    '{{ core_apps_service_path.pihole }}/etc-pihole/pihole-FTL.db'

AUTHENTIK_DB_CONTAINER_NAME='{{ core_apps_backups_authentik_database_container_name }}'
AUTHENTIK_DB_NAME='{{ core_apps_backups_authentik_database_name }}'
AUTHENTIK_DB_USER='{{ core_apps_backups_authentik_database_user }}'
AUTHENTIK_STATIC_FILES="{{ core_apps_service_path.authentik }}"
AUTHENTIK_BACKUP_PATH="$BACKUPS_PATH/authentik-data"
mkdir -p "$AUTHENTIK_BACKUP_PATH"
docker exec "$AUTHENTIK_DB_CONTAINER_NAME" pg_dump -U "$AUTHENTIK_DB_USER" "$AUTHENTIK_DB_NAME" > "$AUTHENTIK_BACKUP_PATH/$AUTHENTIK_DB_NAME-dump.sql"
cp -rf "$AUTHENTIK_STATIC_FILES/"* "$AUTHENTIK_BACKUP_PATH"
# -C changes dir to avoid nested dirs in the archive
tar -czvf "$BACKUPS_PATH/$(backup_filename authentik)" -C "$BACKUPS_PATH" authentik-data
rm -r "$AUTHENTIK_BACKUP_PATH"

AZURE_PATH="{{ core_apps_backups_rclone_azure_remote_name }}:{{ deployment_environment }}-{{ core_apps_backups_azure_blob_container_name }}"

echo 'SCRIPT INFO: Sending pihole backup to Azure'
rclone copyto "$BACKUPS_PATH/$(backup_filename pihole)" "$AZURE_PATH/$(backup_filename pihole)"

echo 'SCRIPT INFO: Sending actual-budget backup to Azure'
rclone copyto "$BACKUPS_PATH/$(backup_filename actual-budget)" "$AZURE_PATH/$(backup_filename actual-budget)"

echo 'SCRIPT INFO: Sending authentik backup to Azure'
rclone copyto "$BACKUPS_PATH/$(backup_filename authentik)" "$AZURE_PATH/$(backup_filename authentik)"
