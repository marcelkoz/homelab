{{ ansible_managed | comment }}

# web interface password
FTLCONF_webserver_api_password={{ vault.pihole_pass }}

# set pihole domain (for web interface /admin redirect)
FTLCONF_webserver_domain={{ global_pihole_fqdn }}

# timezone
TZ=Europe/London

# list on all network interfaces
FTLCONF_dns_listeningMode={{ core_apps_pihole_listening_mode }}

# dont forward private ranges
FTLCONF_dns_bogusPriv={{ (not core_apps_pihole_forward_private_ranges) | string | lower }}

# upstream DNS servers (required for initialising pihole database
FTLCONF_dns_upstreams='{{ core_apps_pihole_upstream_dns | join(";") }}'

# data retention
FTLCONF_database_maxDBdays={{ core_apps_pihole_data_retention }}
FTLCONF_database_network_expire={{ core_apps_pihole_data_retention }}

# DNSSEC for upstream servers
FTLCONF_dns_dnssec={{ core_apps_pihole_dnssec | string | lower }}
