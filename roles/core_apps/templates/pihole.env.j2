{{ ansible_managed | comment }}

# web interface password
FTLCONF_webserver_api_password={{ pihole_password }}

# set pihole domain (for web interface /admin redirect)
FTLCONF_webserver_domain={{ pihole_fqdn }}

# timezone
TZ=Europe/London

# list on all network interfaces
FTLCONF_dns_listeningMode=ALL

# dont forward private ranges
FTLCONF_dns_bogusPriv=true

# upstream DNS servers (required for initialising pihole database
FTLCONF_dns_upstreams='1.1.1.1;1.0.0.1;8.8.8.8;8.8.4.4'

